rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /chat_images/{userId}/{allPaths=**} {
      // Allow read for authenticated users (assuming they have access via DB rules for URLs)
      allow read: if request.auth != null;
      
      // Allow write if user is authenticated and uploading to their own folder
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   // Restrict to images only
                   && request.resource.contentType.matches('image/jpeg|image/png|image/webp')
                   // Max size 10MB
                   && request.resource.size < 10 * 1024 * 1024;
    }
    
    // Add rule for audio files, since the app also supports Voice Notes.
    match /amani-chat/attachments/{roomId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
