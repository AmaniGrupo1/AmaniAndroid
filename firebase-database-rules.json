{
  "rules": {
    "chats": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['idMensaje', 'idSender', 'idReceiver']) && ((newData.hasChild('mensaje') && newData.child('mensaje').val().length > 0 && newData.child('mensaje').val().length <= 2000) || newData.hasChild('attachmentUrl'))"
          }
        }
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "typing": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}

